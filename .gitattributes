# Store text as LF in the repo. Working copies may still use CRLF on Windows.
* text=auto eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf
database/init/*.sh text eol=lf
# Binary
*.png binary
*.jpg binary
*.ico binary
*.pdf binary
*.docx binary
*.xlsx binary
*.ttf binary
*.woff binary
*.woff2 binary
