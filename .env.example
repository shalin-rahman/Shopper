# Copy to .env and adjust. Docker Compose reads these automatically from the project root.
# Production: use long random values; URL-encode special characters in SHOPPER_DATABASE_URL if needed.

SHOPPER_POSTGRES_USER=shopper
SHOPPER_POSTGRES_PASSWORD=shopper_dev_change_me
SHOPPER_POSTGRES_DB=shopper

SHOPPER_APP_PASSWORD=shopper_app_change_me
SHOPPER_MIGRATE_PASSWORD=shopper_migrate_change_me

# API connection (must match SHOPPER_APP_PASSWORD)
SHOPPER_DATABASE_URL=postgresql+asyncpg://shopper_app:shopper_app_change_me@postgres:5432/shopper

# Super Admin API (shopper_migrate bypasses RLS); optional — leave empty to disable /v1/admin/*
SHOPPER_MIGRATE_DATABASE_URL=postgresql+asyncpg://shopper_migrate:shopper_migrate_change_me@postgres:5432/shopper
SHOPPER_ADMIN_API_KEY=

CORS_ALLOW_ORIGINS=*

PLATFORM_ROOT_DOMAIN=

# Redis for caching, rate limits, IPN idempotency (optional job queue later)
REDIS_URL=redis://redis:6379/0

# Payment gateways
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
LETSENCRYPT_EMAIL=
LETSENCRYPT_STAGING=0
ALLOW_ACME_EXTRA_DOMAINS=

# QR payload base for products (storefront URL stub per requirements)
STOREFRONT_PUBLIC_BASE_URL=https://publicportal.example
